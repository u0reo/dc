# 共通の必須項目
TZ=Asia/Tokyo
DOMAIN=example.com
REPO_PATH=/opt/dc

### コメントアウト済みのものはデフォルト値が設定済み、そのほかは必須 ###

# appflowyinc/* イメージのタグ (cloud / gotrue / admin_frontend / worker / web)
# IMG_VER=latest

# 個別リリースのタグ
# IMG_VER_SEARCH=latest
# IMG_VER_AI=latest

# DB パスワード  $ openssl rand -hex 24
POSTGRES_PASSWORD=
# セッション用 JWT シークレット (32文字以上)  $ openssl rand -hex 32
GOTRUE_JWT_SECRET=

# Redis のデータベース番号 (他サービスと重複させない)
# REDIS_DB=8

# S3 (VersityGW) の唯一の root アカウント (single account モード)
# S3_ACCESS_KEY=appflowy
# SECRET_KEY は長め(32文字前後)推奨  $ openssl rand -hex 24
S3_SECRET_KEY=

# 管理者アカウント
GOTRUE_ADMIN_EMAIL=admin@example.com
GOTRUE_ADMIN_PASSWORD=admin_password

# メール (SMTP)
SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASS=sender_password
# SMTP_TLS_KIND=wrapper  # none | wrapper | required | opportunistic

# AI 関連
# AI_ENABLED=true
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=*****
DEFAULT_AI_MODEL=gpt-4.1-mini
DEFAULT_AI_COMPLETION_MODEL=gpt-4.1-mini

# ログレベル
# LOG_LEVEL=info
